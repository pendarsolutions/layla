# Copy to .env and fill in. Never commit .env.

# --- release identity ---
LAYLA_VERSION=1.0.0            # image tag; must change with every release
# set by the deploy command: $(git rev-parse --short HEAD)
LAYLA_GIT_SHA=
LAYLA_ENV=staging              # development | staging | production

# --- model / speed ---
LAYLA_MODEL_DIR=./models/layla-1.0   # host folder with model.safetensors, encoder/, tokenizer/, rl_agent_config.json
LAYLA_MODEL_NAME=layla-1.0
LAYLA_THREADS=6                # torch threads; keep equal to LAYLA_CPUS
LAYLA_CPUS=6                   # container CPU ceiling
LAYLA_MAX_TEXT_TOKENS=512      # longer text keeps its head and tail; lower = faster
LAYLA_CACHE_SIZE=2048          # answers kept in memory (a speed-up only)

# --- access ---
# comma list of name:secret, e.g. web:<random>,partner-a:<random>
LAYLA_API_KEYS=
LAYLA_PUBLIC_DEMO=1            # 1 = calls without a key are allowed, with the anonymous limits below
LAYLA_ANON_RATE_PER_MIN=30
LAYLA_ANON_MAX_CHARS=4000
LAYLA_ANON_MAX_OUTPUTS=6
LAYLA_MAX_CHARS=20000
LAYLA_MAX_OUTPUTS=12
LAYLA_TRUST_PROXY=0            # 1 only when nginx in front sets X-Forwarded-For
# comma list of browser origins allowed to call the API from another site
LAYLA_CORS_ORIGINS=

# --- accounts (sign-in, user keys, free quota) ---
# compose builds LAYLA_DATABASE_URL from this; generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# >= 32 random characters; required in production: openssl rand -hex 32
LAYLA_SESSION_SECRET=
LAYLA_SESSION_DAYS=14
LAYLA_COOKIE_SECURE=0          # 1 once the site is served over HTTPS
# OAuth 2.0 Web client id from Google Cloud Console; empty = Google sign-in off
LAYLA_GOOGLE_CLIENT_ID=
LAYLA_DEV_LOGIN=0              # 1 = email sign-in without Google (never in production; ignored there)
LAYLA_FREE_REQUESTS=100        # requests every new account gets
LAYLA_MAX_KEYS=5               # active API keys per account
LAYLA_AUTO_MIGRATE=1           # run `alembic upgrade head` at startup

# --- protection ---
LAYLA_MAX_INFLIGHT=12          # requests being served or queued; beyond this -> 503 + Retry-After
LAYLA_REQUEST_TIMEOUT_S=30
LAYLA_SERVE_WEB=1              # 1 = the API also serves the web page at /

LAYLA_HOST_PORT=8790           # host port, bound to 127.0.0.1 only
